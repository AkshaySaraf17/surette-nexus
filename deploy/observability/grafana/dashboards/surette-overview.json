{
 "uid": "surette-overview",
 "title": "Surette Nexus \u2014 Overview",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "tags": [
  "surette"
 ],
 "panels": [
  {
   "type": "row",
   "title": "Traffic & errors",
   "collapsed": false,
   "gridPos": {
    "w": 24,
    "h": 1,
    "x": 0,
    "y": 0
   },
   "panels": [],
   "id": 1
  },
  {
   "type": "stat",
   "title": "Requests / s",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(http_request_duration_seconds_count[5m]))"
    }
   ],
   "gridPos": {
    "w": 6,
    "h": 4,
    "x": 0,
    "y": 1
   },
   "id": 2
  },
  {
   "type": "stat",
   "title": "Error rate (5xx)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.01
       },
       {
        "color": "red",
        "value": 0.05
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(http_request_duration_seconds_count{status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_request_duration_seconds_count[5m])),1e-9)"
    }
   ],
   "gridPos": {
    "w": 6,
    "h": 4,
    "x": 6,
    "y": 1
   },
   "id": 3
  },
  {
   "type": "stat",
   "title": "p95 latency",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.75
       },
       {
        "color": "red",
        "value": 1.5
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))"
    }
   ],
   "gridPos": {
    "w": 6,
    "h": 4,
    "x": 12,
    "y": 1
   },
   "id": 4
  },
  {
   "type": "stat",
   "title": "Live connections",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(realtime_connections)"
    }
   ],
   "gridPos": {
    "w": 6,
    "h": 4,
    "x": 18,
    "y": 1
   },
   "id": 5
  },
  {
   "type": "timeseries",
   "title": "Requests by status",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (rate(http_request_duration_seconds_count[5m]))",
     "legendFormat": "{{status}}"
    }
   ],
   "gridPos": {
    "w": 12,
    "h": 8,
    "x": 0,
    "y": 5
   },
   "id": 6
  },
  {

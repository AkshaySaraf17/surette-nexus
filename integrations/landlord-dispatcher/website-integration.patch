+    for e in errors:
+        loc = [str(p) for p in e.get("loc", []) if p != "body"]
+        key = ".".join(loc) or "body"
+        message = str(e.get("msg", "Invalid value")).removeprefix("Value error, ")
+        fields.setdefault(key, message)
+    return _error(422, "VALIDATION_ERROR", "Please fix the highlighted fields.", fields, detail=jsonable(errors))

+    mock = False
+    if client is not None:
+        try:
+            response = client.table(VENDORS_TABLE).select("id,name,trade,email,phone,is_active,insurance_expiry").order("name").execute()
+            rows = list(response.data or [])
+        except Exception:
+            logger.exception("Vendor compliance query failed; serving mock vendors.")
+            client = None
+    if client is None:
+        mock = True
+        rows = [
+            {**v, "is_active": True, "insurance_expiry": (date.today().replace(year=date.today().year + 1)).isoformat()}
+            for v in MOCK_VENDORS.values()
+        ]
+
+    order = {"Expired": 0, "Missing COI": 1, "Expiring": 2, "Inactive": 3, "Compliant": 4}
+    vendors = []
+    for row in rows:
+        status, days = compliance_status(row)
+        vendors.append(
+            {
+                "id": str(row["id"]) if row.get("id") else None,
+                "name": row.get("name") or "Unnamed vendor",
+                "trade": normalize_trade(row.get("trade") or ""),
+                "email": row.get("email"),
+                "phone": row.get("phone"),
+                "is_active": bool(row.get("is_active", True)),
+                "insurance_expiry": (row.get("insurance_expiry") or None),
+                "days_until_expiry": days,
+                "status": status,
+            }
+        )
+    vendors.sort(key=lambda v: (order[v["status"]], v["name"]))

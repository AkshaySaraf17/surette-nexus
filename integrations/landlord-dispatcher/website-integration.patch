+# ---------------------------------------------------------------------------
+# Website integration: vendor compliance feed and vendor acknowledgements
+# ---------------------------------------------------------------------------
+
+EXPIRING_WITHIN_DAYS = 30
+
+
+class DatabaseUnavailable(Exception):
+    """Raised when a write that must persist cannot reach Supabase."""

+"""Website integration helpers: allowed CORS origins, the server-to-server API key,
+and signed vendor-portal links that let a contractor confirm receipt of a job."""
+
+import hashlib
+import hmac
+import logging
+import os
+from typing import Optional
+from urllib.parse import urlencode
+
+logger = logging.getLogger(__name__)
+
+_DEV_ORIGINS = ("http://localhost:3000", "http://127.0.0.1:3000")
+
+
+def allowed_origins() -> list[str]:
+    """Browser origins allowed to call the API (ALLOWED_ORIGINS, comma-separated).
+
+    Defaults to local development origins only; production sites must be listed
+    explicitly (e.g. "https://www.surettere.com,https://surettere.com").
+    """
+    raw = os.getenv("ALLOWED_ORIGINS", "")
+    origins = [o.strip().rstrip("/") for o in raw.split(",") if o.strip()]
+    for origin in origins:
+        if origin == "*":
+            logger.warning("ALLOWED_ORIGINS contains '*'; ignoring it. List the website origins explicitly.")
+    return [o for o in origins if o != "*"] or list(_DEV_ORIGINS)
+
+
+def api_key_ok(provided: Optional[str]) -> bool:
+    """True when no DISPATCHER_API_KEY is configured, or the provided key matches it."""
+    expected = os.getenv("DISPATCHER_API_KEY", "").strip()
+    if not expected:
+        return True
+    return bool(provided) and hmac.compare_digest(provided.encode(), expected.encode())
+
+
+def _link_secret() -> Optional[bytes]:
+    secret = os.getenv("VENDOR_LINK_SECRET", "").strip()
+    return secret.encode() if len(secret) >= 32 else None
+
+
+def vendor_key(vendor: dict) -> str:
+    """Stable identifier for a vendor in links: its id, or its name for mock vendors."""
+    return str(vendor.get("id") or vendor.get("name") or "vendor")[:80]
+
+
+def sign_ack(ticket_ref: str, vendor: str) -> Optional[str]:
+    secret = _link_secret()
+    if secret is None:
+        return None
+    return hmac.new(secret, f"{ticket_ref}:{vendor}".encode(), hashlib.sha256).hexdigest()
+
+
+def verify_ack(ticket_ref: str, vendor: str, signature: str) -> bool:
+    expected = sign_ack(ticket_ref, vendor)
+    return expected is not None and hmac.compare_digest(expected, signature or "")
+
+
+def vendor_portal_link(ticket_ref: str, vendor: dict) -> Optional[str]:
+    """Link to the website's vendor portal confirming receipt, or None if not configured.
+
+    Needs VENDOR_PORTAL_URL (e.g. https://www.surettere.com/vendor-portal/confirm) and a
+    VENDOR_LINK_SECRET of at least 32 characters.
+    """
+    base = os.getenv("VENDOR_PORTAL_URL", "").strip()
+    key = vendor_key(vendor)
+    signature = sign_ack(ticket_ref, key)
+    if not base or not signature:
+        return None
+    separator = "&" if "?" in base else "?"
+    return f"{base}{separator}{urlencode({'ticket': ticket_ref, 'vendor': key, 'sig': signature})}"

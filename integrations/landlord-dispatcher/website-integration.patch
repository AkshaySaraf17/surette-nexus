+def acknowledge_ticket(ticket_ref: str, vendor: str, eta: Optional[str]) -> Optional[dict[str, Any]]:
+    """Mark a ticket as acknowledged by its vendor. Returns the updated row, or None if
+    the ticket doesn't exist or isn't assigned to that vendor. Raises DatabaseUnavailable
+    when Supabase can't be reached (an acknowledgement must not be silently dropped)."""
+    client = get_supabase_client()
+    if client is None:
+        raise DatabaseUnavailable("Supabase is not configured.")
+    try:
+        found = client.table(TICKETS_TABLE).select("id,ticket_ref,vendor_id,vendor_name,status").eq("ticket_ref", ticket_ref).limit(1).execute()
+    except Exception as exc:
+        logger.exception("Ticket lookup failed for %s.", ticket_ref)
+        raise DatabaseUnavailable(str(exc)) from exc
+    if not found.data:
+        return None
+    ticket = found.data[0]
+    if vendor not in {str(ticket.get("vendor_id") or ""), str(ticket.get("vendor_name") or "")}:
+        return None
+    try:
+        updated = (
+            client.table(TICKETS_TABLE)
+            .update({"status": "acknowledged", "acknowledged_at": datetime.now(timezone.utc).isoformat(), "vendor_eta": eta})
+            .eq("ticket_ref", ticket_ref)
+            .execute()
+        )
+    except Exception as exc:
+        logger.exception("Could not record acknowledgement for %s.", ticket_ref)
+        raise DatabaseUnavailable(str(exc)) from exc
+    return (updated.data or [ticket])[0]

+"""Website integration: CORS, error shapes, vendor compliance feed, portal links, timeouts."""
+
+import time
+from datetime import date, timedelta
+from urllib.parse import parse_qs, urlparse
+
+import pytest
+from fastapi.testclient import TestClient
+
+import app.main as main
+from app.models.schemas import TriageResult
+from app.services import database
+from app.services.portal import sign_ack
+
+SECRET = "x" * 40
+
+
+@pytest.fixture(autouse=True)
+def env(monkeypatch):
+    monkeypatch.setenv("SUPABASE_URL", "")
+    monkeypatch.setenv("SUPABASE_KEY", "")
+    monkeypatch.setattr(database, "_client", None)
+    monkeypatch.setenv("VENDOR_PORTAL_URL", "https://www.example-brokerage.com/vendor-portal/confirm")
+    monkeypatch.setenv("VENDOR_LINK_SECRET", SECRET)
+    monkeypatch.delenv("DISPATCHER_API_KEY", raising=False)
+
+
+@pytest.fixture
+def client():
+    with TestClient(main.app) as c:
+        yield c
+
+
+def _stub_triage(monkeypatch):
+    async def fake(_message: str) -> TriageResult:
+        return TriageResult(trade_required="Plumbing", urgency="Standard", clean_summary="Kitchen sink is leaking.")
+
+    monkeypatch.setattr(main, "triage_tenant_message", fake)
+
+
+def test_cors_preflight_allows_listed_origin(client):
+    response = client.options(
+        "/api/v1/tenant-alert",
+        headers={"Origin": "http://localhost:3000", "Access-Control-Request-Method": "POST", "Access-Control-Request-Headers": "content-type"},
+    )
+    assert response.status_code == 200
+    assert response.headers["access-control-allow-origin"] == "http://localhost:3000"
+
+
+def test_cors_preflight_rejects_unknown_origin(client):
+    response = client.options(
+        "/api/v1/tenant-alert",
+        headers={"Origin": "https://evil.example", "Access-Control-Request-Method": "POST"},
+    )
+    assert "access-control-allow-origin" not in response.headers
+
+
+def test_malformed_json_is_400(client):
+    response = client.post("/api/v1/tenant-alert", content="{not json", headers={"Content-Type": "application/json"})
+    assert response.status_code == 400
+    assert response.json()["error"]["code"] == "BAD_REQUEST"
+
+
+def test_invalid_fields_are_422_with_field_messages(client):
+    response = client.post("/api/v1/tenant-alert", json={"phone_number": "12", "message_body": "!!"})
+    assert response.status_code == 422
+    body = response.json()
+    assert body["error"]["code"] == "VALIDATION_ERROR"
+    assert "10 to 15 digits" in body["error"]["fields"]["phone_number"]
+    assert "few words" in body["error"]["fields"]["message_body"]
+    assert "detail" in body  # backward compatible
+
+
+def test_missing_gemini_key_is_clean_503(client, monkeypatch):
+    monkeypatch.setenv("GEMINI_API_KEY", "")
+    monkeypatch.setattr("app.services.triage._client", None)
+    response = client.post("/api/v1/tenant-alert", json={"phone_number": "+12075550123", "message_body": "sink leaking", "source": "website"})
+    assert response.status_code == 503
+    assert response.json()["error"]["code"] == "SERVICE_UNAVAILABLE"
+
+
+def test_email_contains_signed_portal_link(client, monkeypatch):
+    _stub_triage(monkeypatch)
+    response = client.post("/api/v1/tenant-alert", json={"phone_number": "(207) 555-0123", "message_body": "sink leaking", "source": "website"})
+    assert response.status_code == 200
+    data = response.json()
+    link = data["vendor_email"]["portal_link"]
+    assert link and link in data["vendor_email"]["body"]
+    query = parse_qs(urlparse(link).query)
+    assert query["ticket"] == [data["ticket_ref"]]
+    assert query["sig"] == [sign_ack(data["ticket_ref"], query["vendor"][0])]
+    assert data["ticket"]["source"] == "website"
+
+
+def test_no_portal_link_without_secret(client, monkeypatch):
+    _stub_triage(monkeypatch)
+    monkeypatch.setenv("VENDOR_LINK_SECRET", "")
+    data = client.post("/api/v1/tenant-alert", json={"phone_number": "2075550123", "message_body": "sink leaking"}).json()
+    assert data["vendor_email"]["portal_link"] is None
+    assert "Confirm you've received" not in data["vendor_email"]["body"]
+
+
+def test_compliance_feed_falls_back_to_mock(client):
+    response = client.get("/api/v1/vendors/compliance")
+    assert response.status_code == 200
+    data = response.json()
+    assert data["mock"] is True
+    assert {v["status"] for v in data["vendors"]} == {"Compliant"}
+    assert len(data["vendors"]) == 6
+
+
+def test_compliance_requires_key_when_configured(client, monkeypatch):
+    monkeypatch.setenv("DISPATCHER_API_KEY", "k" * 32)
+    assert client.get("/api/v1/vendors/compliance").status_code == 401
+    assert client.get("/api/v1/vendors/compliance", headers={"X-Dispatcher-Key": "k" * 32}).status_code == 200
+
+
+def test_compliance_status_rules():
+    today = date(2026, 10, 14)
+    assert database.compliance_status({"is_active": True, "insurance_expiry": "2027-01-01"}, today)[0] == "Compliant"
+    assert database.compliance_status({"is_active": True, "insurance_expiry": (today + timedelta(days=10)).isoformat()}, today) == ("Expiring", 10)
+    assert database.compliance_status({"is_active": True, "insurance_expiry": "2026-10-13"}, today) == ("Expired", -1)
+    assert database.compliance_status({"is_active": True, "insurance_expiry": None}, today) == ("Missing COI", None)
+    assert database.compliance_status({"is_active": False, "insurance_expiry": "2027-01-01"}, today)[0] == "Inactive"
+
+
+def test_acknowledge_rejects_bad_signature(client):
+    response = client.post("/api/v1/tickets/T-ABCDEF12/acknowledge", json={"vendor": "v1", "sig": "0" * 64})
+    assert response.status_code == 403
+
+
+def test_acknowledge_without_database_is_503(client):
+    sig = sign_ack("T-ABCDEF12", "v1")
+    response = client.post("/api/v1/tickets/T-ABCDEF12/acknowledge", json={"vendor": "v1", "sig": sig, "eta": "4pm"})
+    assert response.status_code == 503
+
+
+def test_slow_database_falls_back_quickly(client, monkeypatch):
+    _stub_triage(monkeypatch)
+    monkeypatch.setattr(main, "DB_TIMEOUT_SECONDS", 0.2)
+
+    def slow(*_args):
+        time.sleep(2)
+        return None
+
+    monkeypatch.setattr(database, "get_tenant_context", slow)
+    monkeypatch.setattr(database, "get_vendor_by_trade", slow)
+    started = time.monotonic()
+    response = client.post("/api/v1/tenant-alert", json={"phone_number": "+12075550123", "message_body": "sink leaking"})
+    assert response.status_code == 200
+    assert response.json()["vendor"]["is_mock"] is True
+    assert time.monotonic() - started < 1.5

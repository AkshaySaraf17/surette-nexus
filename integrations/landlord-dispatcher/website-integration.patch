+def compliance_status(vendor: dict[str, Any], today: Optional[date] = None) -> tuple[str, Optional[int]]:
+    """Classify a vendor's certificate of insurance: (status, days until expiry)."""
+    today = today or date.today()
+    raw = vendor.get("insurance_expiry")
+    expiry: Optional[date] = None
+    if isinstance(raw, date):
+        expiry = raw
+    elif isinstance(raw, str) and raw:
+        try:
+            expiry = date.fromisoformat(raw[:10])
+        except ValueError:
+            expiry = None
+    days = (expiry - today).days if expiry else None
+    if not vendor.get("is_active", True):
+        return "Inactive", days
+    if expiry is None:
+        return "Missing COI", None
+    if days is not None and days < 0:
+        return "Expired", days
+    if days is not None and days <= EXPIRING_WITHIN_DAYS:
+        return "Expiring", days
+    return "Compliant", days
+
+
+def list_vendor_compliance() -> tuple[list[dict[str, Any]], bool]:

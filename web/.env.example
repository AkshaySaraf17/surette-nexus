# Local Postgres from ../scripts/db.sh (port 5434), or any PostgreSQL 15+ connection string.
DATABASE_URL="postgresql://surette@localhost:5434/surette"
# Long random string used to sign session tokens: openssl rand -base64 48
JWT_SECRET=""
# Public origin of this site (used in emails, webhooks and vendor-portal links).
PUBLIC_SITE_URL="http://localhost:3100"
# Slug of the agent_teams row this site represents.
SITE_TEAM_SLUG="surette"
# Where optimized uploads are written. Served at /media/*.
STORAGE_DIR=".storage"
# Comma-separated browser origins allowed to call /api (Expo web, the client's existing site...).
CORS_ORIGINS="http://localhost:8081"

# Local AI (optional, free): run Ollama (https://ollama.com) and pull a model, e.g. `ollama pull llama3.2:3b`.
# Without it every feature still works using deterministic answers. No hosted AI API is ever called.
OLLAMA_URL=""
OLLAMA_MODEL="llama3.2:3b"

# Market data: FRED needs no key. Census ACS demographics need a free key:
# https://api.census.gov/data/key_signup.html  (leave empty to show those metrics as unavailable)
# Not needed: Census data comes from keyless bulk files (see data/gov/README.md).
CENSUS_API_KEY=""

# First-party analytics: the project key this site reports to, and the consent mode.
# opt-in = nothing is collected until the visitor clicks Allow (recommended default).
NEXT_PUBLIC_ANALYTICS_PROJECT="nexus-site"
NEXT_PUBLIC_ANALYTICS_CONSENT_MODE="opt-in"

# Tenant maintenance intake + vendor compliance come from the landlord-dispatcher (FastAPI) backend.
# Leave empty to hide those widgets.
DISPATCHER_API_URL=""
# Shared secret the dispatcher checks on compliance requests from this site (server-to-server only).
DISPATCHER_API_KEY=""

# --- Scale & reliability (all optional locally; see docs/system-design.md) ---
# Read replica for analytics/market reads, and a direct (non-PgBouncer) URL for LISTEN/NOTIFY.
DATABASE_READ_URL=""
DATABASE_DIRECT_URL=""
DATABASE_POOL_SIZE="10"
DATABASE_STATEMENT_TIMEOUT_MS="15000"
# Redis: shared rate limits + shared cache. Without it: Postgres-backed limits, in-process cache.
REDIS_URL=""
# redis | postgres | memory (default: redis if REDIS_URL, else postgres in production, memory in dev)
RATE_LIMIT_STORE=""
# Prometheus scrape token for /api/metrics (required in production).
METRICS_TOKEN=""
LOG_LEVEL="info"
LOG_PRETTY="0"
# Background worker: run inside `npm run dev` (1) or separately with `npm run worker` (0).
EMBEDDED_WORKER="1"
WORKER_CONCURRENCY="4"
WORKER_PORT="9464"
# WebSocket live updates (`npm run realtime`). Leave NEXT_PUBLIC_REALTIME_URL empty to use SSE only.
REALTIME_PORT="3200"
NEXT_PUBLIC_REALTIME_URL=""
REALTIME_ALLOWED_ORIGINS=""

# --- Email (verification + password reset links) ---
# Leave SMTP_HOST empty in development: mail goes to Mailpit (free local inbox) on localhost:1025,
# viewable at http://localhost:8025 (brew install mailpit && brew services start mailpit).
# Production example (Gmail with an app password): smtp.gmail.com, 587, your address, the app password.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
MAIL_FROM="Surette Real Estate <no-reply@example.com>"

# --- Sign in with Google (optional, free) ---
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID → Web application.
# Authorized redirect URI: <PUBLIC_SITE_URL>/api/auth/google/callback  (e.g. http://localhost:3100/api/auth/google/callback)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

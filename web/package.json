{
  "name": "surette-nexus-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:seed": "tsx --env-file=.env --conditions=react-server scripts/seed.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "postinstall": "node scripts/copy-vendor.mjs",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "predev": "node ../scripts/sync-public.mjs",
    "prebuild": "node ../scripts/sync-public.mjs",
    "market:refresh": "tsx --env-file=.env --conditions=react-server scripts/market-refresh.ts",
    "admin:create": "tsx --env-file=.env --conditions=react-server scripts/create-admin.ts",
    "analytics:demo": "tsx --env-file=.env --conditions=react-server scripts/generate-demo-events.ts",
    "analytics:purge": "tsx --env-file=.env --conditions=react-server scripts/analytics-purge.ts",
    "worker": "SERVICE_NAME=surette-worker tsx --env-file=.env --conditions=react-server scripts/worker.ts",
    "realtime": "SERVICE_NAME=surette-realtime tsx --env-file=.env --conditions=react-server scripts/realtime.ts",
    "worker:prod": "tsx --conditions=react-server scripts/worker.ts",
    "realtime:prod": "tsx --conditions=react-server scripts/realtime.ts",
    "db:migrate:prod": "tsx scripts/migrate.ts",
    "data:gov:download": "tsx --env-file=.env --conditions=react-server scripts/gov-data/download.ts",
    "data:gov:import": "tsx --env-file=.env --conditions=react-server scripts/gov-data/import.ts",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:data": "vitest run tests/data",
    "test:config": "vitest run tests/config",
    "test:contract": "RUN_NETWORK_TESTS=1 vitest run tests/contract",
    "test:a11y": "playwright test e2e/accessibility",
    "test:security": "playwright test e2e/security",
    "test:load": "node load/smoke.load.mjs",
    "test:all": "vitest run && playwright test",
    "docs:export": "node scripts/docs-export.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "ioredis": "^5.6.1",
    "jose": "^6.2.12",
    "lenis": "^1.3.27",
    "lucide-react": "^1.57.0",
    "maplibre-gl": "^6.14.0",
    "motion": "^14.2.0",
    "next": "16.4.0",
    "nodemailer": "^7.0.5",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "pino": "^9.7.0",
    "prom-client": "^15.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "ws": "^8.18.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/busboy": "^1.5.5",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "autocannon": "^8.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "marked": "^15.0.12",
    "mermaid": "^11.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.7"
  }
}
